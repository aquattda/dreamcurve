diff --git a/tests/unit/somnia-shannon-config.test.ts b/tests/unit/somnia-shannon-config.test.ts
new file mode 100644
--- /dev/null
+++ b/tests/unit/somnia-shannon-config.test.ts
@@ -0,0 +1,18 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { CHAIN_CONFIG, getRpcUrlByChainId } from "../../lib/rpc/rpc-config";
+
+describe("Somnia Shannon configuration", () => {
+  afterEach(() => vi.unstubAllEnvs());
+  it("registers an explicit Shannon RPC configuration", () => {
+    expect(CHAIN_CONFIG[50312]).toMatchObject({
+      jsonKey: "somnia-shannon",
+      publicDefault: "https://dream-rpc.somnia.network",
+      publicFallback: "https://api.infra.testnet.somnia.network",
+    });
+  });
+  it("honors the dedicated primary RPC override", () => {
+    vi.stubEnv("CHAIN_RPC_CONFIG", "");
+    vi.stubEnv("CHAIN_SOMNIA_SHANNON_PRIMARY_RPC", "https://rpc.example.test");
+    expect(getRpcUrlByChainId(50312)).toBe("https://rpc.example.test");
+  });
+});
