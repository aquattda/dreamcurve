PORT=8787
HOST=127.0.0.1
DATABASE_PATH=./data/dreamcurve.sqlite
# Heroku Postgres sets DATABASE_URL automatically; it takes priority over SQLite.
DATABASE_URL=
SOMNIA_RPC_URL=https://dream-rpc.somnia.network
SOMNIA_WS_RPC_URL=wss://api.infra.testnet.somnia.network/ws
DREAMDEX_INDEXER_URL=https://dev.smk.somnia.host/v1/graphql
# Optional: scope discovery after verifying a live venue.
DREAMDEX_VENUE_ID=
# Server is read-only. Users sign transactions in their browser wallet.
COLLECTOR_ENABLED=true
