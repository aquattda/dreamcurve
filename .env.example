PORT=8787
HOST=127.0.0.1
DATABASE_PATH=./data/dreamcurve.sqlite
# Heroku Postgres sets DATABASE_URL automatically; it takes priority over SQLite.
DATABASE_URL=
SOMNIA_RPC_URL=https://dream-rpc.somnia.network
SOMNIA_WS_RPC_URL=wss://api.infra.testnet.somnia.network/ws
DREAMDEX_INDEXER_URL=https://dev.smk.somnia.host/v1/graphql
# Optional: scope discovery after verifying a live venue.
DREAMDEX_VENUE_ID=
# Legacy direct trades are signed in the browser. KeeperHub credentials stay on server.
COLLECTOR_ENABLED=true

# The hosted registry did not include Shannon at the initial audit.
# Use a real KeeperHub deployment with chain 50312 enabled; never a direct-write shim.
KEEPERHUB_BASE_URL=https://app.keeperhub.com
KEEPERHUB_API_KEY=
KEEPERHUB_WALLET_ADDRESS=
# Comma-separated browser wallet addresses authorized to approve org-wallet intents.
KEEPERHUB_OPERATOR_ADDRESSES=
# Set to eoa only after verifying org writes do NOT route through a Safe.
KEEPERHUB_SIGNER_MODE=
# Unique per deployment; changing it invalidates existing authorizations.
KEEPERHUB_AUTHORIZATION_DOMAIN=dreamcurve.local
# Shannon only. Limits can be lowered, never raised above the test-demo ceilings.
KEEPERHUB_CHAIN_ID=50312
KEEPERHUB_MAX_TRADE_TUSDC=1
# Cumulative attempted trade budgets per executor in the durable audit database.
# Browser reloads, operator changes and server restarts do not reset usage.
KEEPERHUB_MAX_SESSION_TUSDC=5

# Earn is separate from Shannon: do NOT change KEEPERHUB_CHAIN_ID above.
EARN_CHAIN_ID=11155111
EARN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Default false: no broadcasts until the operator verifies free quota and no paid overage.
# This is a local acknowledgment, NOT a KeeperHub billing API or quota guarantee.
EARN_FREE_TIER_CONFIRMED=false
